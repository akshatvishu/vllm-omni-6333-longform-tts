+_SENTENCE_BOUNDARIES = frozenset(".,;:!?。，；：！？")
+_CLAUSE_BOUNDARIES = frozenset(",;:，；：、")
+_CLOSING_MARKS = frozenset("\"'“”‘’）]》>」】")
+_ABBREVIATIONS = frozenset(
