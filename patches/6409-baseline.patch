+def _copy_audio_to_cpu(
+    audio: torch.Tensor,
+    copy_stream: torch.Stream | None,
+) -> torch.Tensor:
+    if audio.device.type == "cpu":
+        return audio
+    if copy_stream is None:
+        return audio.detach().cpu()
+
